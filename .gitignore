# ============================================================
# .gitignore for C# / .NET Projects
# ============================================================

# -----------------------------------------------
# ビルド出力 / Build Output
# -----------------------------------------------
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# -----------------------------------------------
# Visual Studio ファイル / Visual Studio Files
# -----------------------------------------------
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# -----------------------------------------------
# NuGet パッケージ / NuGet Packages
# -----------------------------------------------
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets
project.lock.json
project.fragment.lock.json
artifacts/

# -----------------------------------------------
# .NET Core / SDK
# -----------------------------------------------
project.json
*.xproj
*.pubxml
*.publishsettings
orleans.codegen.cs

# -----------------------------------------------
# テスト結果 / Test Results
# -----------------------------------------------
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
TestResult.xml
*.trx
*.coverage
*.coveragexml

# -----------------------------------------------
# ReSharper
# -----------------------------------------------
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# -----------------------------------------------
# Rider
# -----------------------------------------------
.idea/
*.sln.iml

# -----------------------------------------------
# VS Code
# -----------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# -----------------------------------------------
# Windows 固有 / Windows Specific
# -----------------------------------------------
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# -----------------------------------------------
# macOS 固有 / macOS Specific
# -----------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# -----------------------------------------------
# Linux 固有 / Linux Specific
# -----------------------------------------------
*~
.fuse_hidden*
.directory
.Trash-*

# -----------------------------------------------
# Azure / クラウド / Cloud
# -----------------------------------------------
csx/
*.azurePubxml
*.pubxml
*.publishsettings
appsettings.*.json
!appsettings.Development.json

# -----------------------------------------------
# Entity Framework
# -----------------------------------------------
migrations/*.Designer.cs

# -----------------------------------------------
# その他 / Miscellaneous
# -----------------------------------------------
*.pidb
*.svclog
*.scc
_Chutzpah*
ipch/
*.aps
*.ncb
*.opendb
*.opensdf
*.sdf
*.cachefile
*.VC.db
*.VC.VC.opendb
*.psess
*.vsp
*.vspx
*.sap
*.e2e
$tf/
*.gpState
_ReSharper*/
[Tt]humbs.db